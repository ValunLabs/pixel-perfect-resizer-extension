{
  "manifest_version": 3,
  "name": "PixelPerfect Image Resizer",
  "short_name": "PixelPerfect",
  "version": "1.0.0",
  "description": "Right-click any image to resize it with PixelPerfectResizer — 100% client-side, private, no uploads.",
  "homepage_url": "https://pixelperfectresizer.com/",
  "permissions": ["contextMenus", "activeTab"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PixelPerfect Image Resizer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
